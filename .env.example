# Template versionato: nessuna chiave, DSN, password o ID reali.
# Locale:  cp .env.example .env.local
# Railway: imposta le stesse chiavi nella dashboard del servizio (non committare i valori).

# --- Database ---
# Locale / Docker: DB_*. Su Railway preferisci DATABASE_URL del plugin Postgres
# (postgres:// e postgresql:// vengono convertiti in postgresql+psycopg://).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tn_be
# DATABASE_URL=
# DATABASE_URL_ASYNC=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
# Railway inietta PORT: non serve in locale (default 8000).
# PORT=8000
TN_BE_PORT=8000

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=72

# --- Redis (obbligatorio se REFRESH_TOKEN_STORE=redis) ---
# Host: localhost. Container tn-be: compose forza redis://tn-redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REFRESH_TOKEN_STORE=redis

# --- Brevo (vuoto = nessuna email, solo log) ---
BREVO_API_KEY=
# ID liste Brevo per contatti CRM in console (virgola); vuoto = tutti i contatti account
BREVO_CRM_LIST_IDS=
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=Financ&youth
BREVO_EMAIL_VERIFICATION_TEMPLATE_ID=0
BREVO_EMAIL_VERIFICATION_LINK_PARAM=verification_url
BREVO_EMAIL_VERIFICATION_FIRST_NAME_PARAM=first_name
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000/auth/verify-email
BREVO_WELCOME_TEMPLATE_ID=0
BREVO_WELCOME_FIRST_NAME_PARAM=first_name
BREVO_WELCOME_LINK_PARAM=app_url
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
BREVO_PASSWORD_RESET_TEMPLATE_ID=0
BREVO_PASSWORD_RESET_LINK_PARAM=reset_url
BREVO_PASSWORD_RESET_FIRST_NAME_PARAM=first_name
EVENT_DETAIL_FRONTEND_URL=http://localhost:3000/events
BREVO_EVENT_CONFIRMATION_REQUEST_TEMPLATE_ID=0
BREVO_EVENT_CONFIRMATION_REMINDER_TEMPLATE_ID=0
BREVO_EVENT_CONFIRMATION_FOLLOWUP_TEMPLATE_ID=0
BREVO_EVENT_CONFIRMATION_EXPIRED_TEMPLATE_ID=0
BREVO_EVENT_WAITLIST_PROMOTED_TEMPLATE_ID=0
BREVO_EVENT_REMINDER_TEMPLATE_ID=0
BREVO_EVENT_WAITLIST_JOINED_TEMPLATE_ID=0
BREVO_EVENT_REGISTRATION_AUTO_CANCELLED_TEMPLATE_ID=0
BREVO_EVENT_REGISTRATION_SYSTEM_CANCELLED_TEMPLATE_ID=0
BREVO_EVENT_REGISTRATION_CONFIRMED_TEMPLATE_ID=0
BREVO_CONNECTION_REQUEST_TEMPLATE_ID=0
BREVO_CONNECTION_EVENT_REGISTERED_TEMPLATE_ID=0
BREVO_CONNECTION_EVENT_CANCELLED_TEMPLATE_ID=0

# --- OAuth (ID e secret solo in .env.local / dashboard) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_EXPIRE_MINUTES=10
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/linkedin/callback
LINKEDIN_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback
LINKEDIN_OAUTH_STATE_EXPIRE_MINUTES=10

# --- WebAuthn / passkey ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Financ&youth
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_EXPIRE_MINUTES=5

# --- Sentry (vuoto = SDK disabilitato) ---
SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=

# --- Media / storage ---
# URL pubblico di tn-be (QR email + GET /media/... per avatar e cover).
# Railway: HTTPS del servizio API (stesso host del callback Google).
PUBLIC_API_URL=http://127.0.0.1:8000
# local = disco. s3 = Railway Bucket (privato: i file escono da /media su tn-be).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
# Su Railway (tn-be), reference al servizio Bucket:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
# S3_REGION=${{Bucket.REGION}}
# S3_BUCKET=${{Bucket.BUCKET}}
# S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# S3_ADDRESSING_STYLE=virtual
# (path solo se il tab Credentials del bucket lo indica)

# --- Solo Docker locale (non usare in Railway) ---
# Se omessi, compose usa i default (pgAdmin :5050, redis-commander :8081).
PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=
# PGADMIN_DEFAULT_PASSWORD=
REDIS_COMMANDER_PORT=8081
# REDIS_COMMANDER_USER=
# REDIS_COMMANDER_PASSWORD=
